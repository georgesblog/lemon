node_modules
dist
dist-ssr
.DS_Store
*.local
.vite

# Secrets / env — only .env.example is tracked. `*.local` already covers
# .env.local; these lines catch the other conventional env filenames so a real
# key can never be committed by accident.
.env
.env.*
!.env.example

# Personal-use catalog importer: the scraper, its service_role secret, and any
# scraped third-party data live here and must never reach the public repo or a
# deploy. (Mirrors the same ignore on the catalog_items migration branch.)
/private/
